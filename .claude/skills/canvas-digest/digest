#!/bin/sh
# digest: lay out a large body of connected information as boards in Infinite Canvas.
# The only file here that runs `canvas`; tool/ (JavaScript, run by the system jsc, else node) reads and writes files and never runs it.
#
#   digest check   GRAPH                      the graph document against its structure and the app's kinds (canvas kinds)
#   digest measure GRAPH                      how big the app makes each shape and pill (canvas measure) -> OUT/measure.json
#   digest plan    GRAPH [PLAN FLAGS]         lay out every board and decide the pills -> OUT/drawing.json, OUT/report.json; draws nothing
#                                             (measures first when there is no measurement, or the graph is newer than it)
#   digest apply   [--dry-run]                canvas apply of OUT/drawing.json: the whole drawing in one step -> OUT/results/apply.json
#   digest all     GRAPH                      check, measure, plan (from where the drawing is now, when the file holds it), apply --dry-run, apply
#   digest ready   [--on NAME]                whether a draw could start: canvas found, the app answering with a board open, canvas apply known
#
#   GRAPH       the graph document (canvas-digest's reference/graph.md): nodes by key, edges, props the app reads, layout hints
#   --out DIR   where the files go (default: GRAPH without .json, plus .out; apply and ready take it when GRAPH is left out)
#   --on NAME   draw on the board that NAME names (a subboard's title, path or #id), else the front board's root; a drawing the file
#               already holds is updated where it is
#   --board ID  draw on an open board by its id (canvas boards)
#   --dry-run   apply: answer what would be done, changing nothing
#   PLAN FLAGS  --mess 0..1  --promote off  --prefer N  --cap 0..1  --margin PILLS  --popular ARROWS
#               --view WxH        the room the window has for a board fit to it, which every board is laid out for (with no view, one of
#                                 1440x960 is assumed, and the plan says so)
#               --ranks rows|columns   which way a document's ranked shapes run (left out: its layout.ranks, else whichever the view shows larger)
#               --current FILE    plan from where the drawing's shapes are now (canvas query ':drawn-by("NAME")' --brief); all asks for it
#   --timeout S seconds canvas may take to answer one command (default 120)
#
# canvas is $CANVAS_CLI, else the one beside this driver (the app's, when it is in the app's Contents/Resources/agents; build/canvas, when it is in a
# checkout of the repository), else the one on PATH (`canvas install` puts it there). Exit status: 0 done; 1 refused or failed (the app's words, naming
# the keys, on standard error: nothing is drawn); 2 the command line is wrong.
set -eu

# fd 3 is the driver's own standard error: whatever a command's output is redirected to, a failure is said there.
exec 3>&2

HERE=$(cd "$(dirname "$0")" && pwd)
TOOL=$HERE/tool
REPO=$(cd "$HERE/../../.." && pwd -P)
JSC=${JSC:-/System/Library/Frameworks/JavaScriptCore.framework/Versions/Current/Helpers/jsc}

die() { echo "digest: $*" >&3; exit 1; }
usage() { sed -n '2,/^set -eu/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' >&3; exit 2; }

abspath() { case $1 in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$PWD" "$1" ;; esac; }

# The tool: jsc cannot take relative paths from another folder, so every path handed to it is absolute. Its answer is on standard output.
# If it fails, what it said goes to the driver's standard error (jsc says an error on its standard output too, which is dropped) and the status is not 0.
tool() {
  if [ -x "$JSC" ]; then
    _tout=$OUT/.tool.out
    if (cd "$TOOL" && "$JSC" main.js -- "$@") > "$_tout" 2>&3; then cat "$_tout"; else return 1; fi
  elif command -v node >/dev/null 2>&1; then
    node "$TOOL/main.js" "$@" 2>&3
  else
    die "no JavaScript engine: neither jsc ($JSC) nor node"
  fi
}

# The tool, its answer into the file $1. A failure stops the driver (the tool has said why).
tool_to() {
  _tf=$1; shift
  tool "$@" > "$_tf" || exit 1
}

# The canvas this driver is beside: the app's (Contents/Helpers/canvas) when the driver is in the app's Contents/Resources/agents, build/canvas when
# it is in a checkout of this repository. Never one found from the current folder: a copy of the driver runs whatever folder it is run from.
beside_canvas() {
  _here=$(cd "$HERE" && pwd -P)
  case $_here in
    */Contents/Resources/agents/canvas/skills/*) _beside=${_here%/Resources/agents/canvas/skills/*}/Helpers/canvas ;;
    *)
      _beside=
      if [ "$_here" = "$REPO/.claude/skills/canvas-digest" ] && [ -f "$REPO/build.sh" ] && [ -f "$REPO/Sources/CanvasCLI/main.swift" ]; then _beside=$REPO/build/canvas; fi ;;
  esac
  if [ -n "$_beside" ] && [ -x "$_beside" ]; then printf '%s\n' "$_beside"; fi
}

# The build of the app answering (`canvas status`'s `build:` line): nothing when it says none, or doesn't answer.
app_build() {
  "$CANVAS" status --format text --timeout 10 2>/dev/null | sed -n 's/^build: *//p' | head -n 1 || true
}

# A copy of the skills left behind by an update, said once: build-id, beside this driver, is the build of the app the skills came from, and
# the app answering (`canvas status`) says its own. This repository's checkout has no build-id (its skills are not a copy), and says nothing.
warn_if_stale() {
  [ -f "$HERE/build-id" ] || return 0
  _mine=$(cat "$HERE/build-id")
  _app=$(app_build)
  if [ -n "$_app" ] && [ "$_app" != "$_mine" ]; then
    echo "digest: warning: these skills are from build $_mine, and the app answering is build $_app: run \`canvas install\` again to bring them up to date" >&3
  fi
}

# canvas is looked up here, by a name nothing of ours answers to (the functions below are run_canvas, canvas_try and canvas_to).
find_canvas() {
  if [ -n "${CANVAS_CLI:-}" ]; then CANVAS=$CANVAS_CLI
  else
    CANVAS=$(beside_canvas)
    [ -n "$CANVAS" ] || CANVAS=$(command -v canvas || true)
  fi
  [ -n "$CANVAS" ] && [ -x "$CANVAS" ] || die "can't find canvas: set CANVAS_CLI, run canvas install (or put canvas on your PATH), or, in the Infinite Canvas repository, build it (./build.sh)"
  export CANVAS_FORMAT=json
  warn_if_stale
}

# canvas, with the time one answer may take (a measure or an apply of a big document is more than its 10 s).
run_canvas() {
  [ -n "${CANVAS:-}" ] || find_canvas
  _cmd=$1; shift
  "$CANVAS" "$_cmd" --timeout "$TIMEOUT" "$@"
}

# Run canvas, keeping its answer in $1 and its complaint in $1.err; the status is canvas's.
canvas_try() {
  _out=$1; shift
  run_canvas "$@" > "$_out" 2> "$_out.err"
}

# What canvas complained of ($1.err), in the app's words: each refusal of a document by its key, else what it said as it said it. $2, a drawing.json,
# names an edge by its ends (the app counts edges by that file's list, not the graph document's).
say_refusal() {
  if grep -q '"refusals"' "$1.err" 2>/dev/null && tool refusals "$1.err" ${2:+"$2"} >"$1.said" 2>/dev/null; then cat "$1.said" >&2; else cat "$1.err" >&2; fi
}

# Run canvas, keeping its answer in $1 and its complaint in $1.err; on a failure, say what it said and stop.
canvas_to() {
  _out=$1; shift
  if ! canvas_try "$_out" "$@"; then
    echo "digest: canvas $1 failed:" >&2
    say_refusal "$_out"
    exit 1
  fi
}

# ---- arguments -----------------------------------------------------------------------------------------------

[ $# -ge 1 ] || usage
CMD=$1; shift
GRAPH=
case $CMD in check|measure|plan|all) [ $# -ge 1 ] || usage ;; apply|ready) ;; *) usage ;; esac
case ${1:-} in --*|'') ;; *) GRAPH=$1; shift ;; esac
case $CMD in check|measure|plan|all) [ -n "$GRAPH" ] || usage; [ -f "$GRAPH" ] || die "no graph document at $GRAPH" ;; esac
[ -z "$GRAPH" ] || GRAPH=$(abspath "$GRAPH")   # every path handed to the tool is absolute (apply and ready take the graph only to name the folder)
ON=; BOARD=; OUT=; DRYRUN=0; TIMEOUT=120; CURRENT=; PLANFLAGS=
while [ $# -gt 0 ]; do
  if [ "$1" = --dry-run ]; then DRYRUN=1; shift; continue; fi
  [ $# -ge 2 ] || { echo "digest: $1 takes a value" >&2; usage; }
  case $1 in
    --out) OUT=$(abspath "$2") ;;
    --on) ON=$2 ;;
    --board) BOARD=$2 ;;
    --timeout) TIMEOUT=$2 ;;
    --current) CURRENT=$(abspath "$2") ;;
    --mess|--promote|--prefer|--cap|--margin|--popular|--view|--ranks) PLANFLAGS="$PLANFLAGS $1 $2" ;;
    *) echo "digest: unknown option $1" >&2; usage ;;
  esac
  shift 2
done
if [ -z "$OUT" ]; then
  if [ -n "$GRAPH" ]; then OUT=${GRAPH%.json}.out
  elif [ "$CMD" = ready ]; then OUT=${TMPDIR:-/tmp}/digest-ready.$$
  else die "$CMD needs where the files are: --out DIR (or the graph, whose folder is GRAPH without .json, plus .out)"
  fi
fi
[ "$CMD" = apply ] || mkdir -p "$OUT/results"   # apply makes its folder once there is a drawing to apply
find_canvas

# ---- the steps -----------------------------------------------------------------------------------------------

# What the app says of its kinds (canvas kinds), which the tool reads every node by: what each holds and the pills that can stand for it,
# kept in $OUT/kinds.json. Asked once a run; a plan from a measurement, with no canvas to ask, reads the answer an earlier run kept.
need_kinds() {
  [ "${_kinds_asked:-0}" = 0 ] || return 0
  _kinds_asked=1
  canvas_to "$OUT/kinds.json" kinds
}

step_check() {
  need_kinds
  tool_to "$OUT/check.json" check "$GRAPH" --kinds "$OUT/kinds.json"
  _errors=$(tool extract errors "$OUT/check.json") || exit 1
  tool check-text "$OUT/check.json"
  [ "$_errors" = 0 ] || { echo "digest: check found errors; fix the graph document and run it again" >&2; exit 1; }
}

# The graph as given, measured by the app (canvas measure): sizes by key, the width of each title over a frame, the pills, and the edges the
# app would refuse. A document it can't read is refused there, by key.
step_measure() {
  need_kinds
  # measured from the board apply will draw on (--on), so a pill says where its shape is from there, as drawn
  canvas_to "$OUT/measure.json" measure - ${BOARD:+--board "$BOARD"} ${ON:+--on "$ON"} < "$GRAPH"
  echo "measure: $(tool count nodes "$OUT/measure.json") nodes measured by canvas measure"
}

step_plan() {
  need_kinds
  if [ ! -s "$OUT/measure.json" ] || [ "$GRAPH" -nt "$OUT/measure.json" ]; then step_measure; fi
  rm -f "$OUT/drawing.json" "$OUT/report.json"
  set -- plan "$GRAPH" "$OUT/measure.json" "$OUT" --kinds "$OUT/kinds.json"
  # shellcheck disable=SC2086
  set -- "$@" $PLANFLAGS
  # Laid out for the window it will be seen in: the room its board's window has (canvas boards' view), unless --view says, and no window, none.
  case " $PLANFLAGS " in
    *" --view "*) ;;
    *) if canvas_try "$OUT/boards.json" boards; then _view=$(tool view "$OUT/boards.json" $BOARD) && [ -n "$_view" ] && set -- "$@" --view "$_view"; fi ;;
  esac
  if [ -n "$CURRENT" ]; then set -- "$@" --current "$CURRENT"; fi
  _res=$(tool "$@") || exit 1
  echo "$_res"
}

# Where the drawing's shapes are now, when the file holds the drawing: written to $OUT/current.json (the rows with their boxes and the containers
# they are in), and CURRENT set to it. A file without the drawing has none, and the plan starts afresh.
step_current() {
  _q=$(tool drawn-by "$GRAPH") || exit 1
  CURRENT=
  rm -f "$OUT/current.json"
  # a file without the drawing answers no rows; any other failure (too slow, timed out) is not that, and drawing from scratch would move a person's shapes back
  if ! canvas_try "$OUT/current.json" query "$_q" --brief --limit 100000 ${BOARD:+--board "$BOARD"}; then
    echo "digest: canvas query could not say where the drawing's shapes are, so the layout would not start from where they are; nothing is drawn. What canvas said:" >&2
    say_refusal "$OUT/current.json"
    rm -f "$OUT/current.json"
    exit 1
  fi
  if [ "$(tool count rows "$OUT/current.json")" != 0 ]; then
    CURRENT=$OUT/current.json
    echo "current: $(tool count rows "$CURRENT") shapes of the drawing are in the file; the layout starts from where they are"
  else
    rm -f "$OUT/current.json"
  fi
}

step_apply() {
  [ -s "$OUT/drawing.json" ] || die "no drawing at $OUT/drawing.json: run plan first"
  mkdir -p "$OUT/results"
  set -- apply -
  if [ -n "$ON" ]; then set -- "$@" --on "$ON"; fi
  if [ -n "$BOARD" ]; then set -- "$@" --board "$BOARD"; fi
  _name=apply
  if [ "$DRYRUN" = 1 ]; then set -- "$@" --dry-run; _name=apply.dry; fi
  if ! canvas_try "$OUT/results/$_name.json" "$@" < "$OUT/drawing.json"; then
    # only a refusal is known to have changed nothing; a hang-up on a slow apply leaves the app to finish it
    if grep -q '"reason" *: *"timed_out"' "$OUT/results/$_name.json.err" 2>/dev/null; then
      echo "digest: canvas gave up waiting for apply, and the app may still be applying the drawing: look at the board before running it again (--timeout S waits longer). What canvas said:" >&2
    elif grep -q '"refusals"\|"reason" *: *"refused"' "$OUT/results/$_name.json.err" 2>/dev/null; then
      echo "digest: canvas apply refused the drawing; nothing was changed:" >&2
    else
      echo "digest: canvas apply failed:" >&2
    fi
    say_refusal "$OUT/results/$_name.json" "$OUT/drawing.json"
    exit 1
  fi
  tool applied "$OUT/results/$_name.json" "$OUT/drawing.json"
}

# Whether a draw could start: said before a caller spends minutes making the document.
step_ready() {
  canvas_to "$OUT/boards.json" boards   # the app answers (canvas says how to start it when it doesn't)
  grep -q '"id"' "$OUT/boards.json" || die "no board is open in the app: open one (or make one with canvas new), then draw"
  # ... and it and canvas are new enough: apply is the newest thing the skill asks of them
  if ! canvas_try "$OUT/ready.apply.txt" help apply; then
    echo "digest: canvas apply doesn't answer, so the canvas found ($CANVAS) or the app that is running is older than this skill needs. Open the app this canvas came with, or run canvas install from the app you mean to use (in the Infinite Canvas repository: ./build.sh, then open its build). What canvas said:" >&2
    cat "$OUT/ready.apply.txt.err" >&2; exit 1
  fi
  echo "ready: the app is running with a board open, and canvas apply is there"
}

case $CMD in
  ready)   step_ready ;;
  check)   step_check ;;
  measure) step_measure ;;
  plan)    step_plan ;;
  apply)   step_apply ;;
  all)
    step_check; step_measure
    [ -n "$CURRENT" ] || step_current
    step_plan
    DRYRUN=1; step_apply; DRYRUN=0; step_apply ;;
esac
